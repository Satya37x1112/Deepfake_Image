profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#1256, Checkpile should be committed, but pipenv's own common practice
#   is to ignore Pipfile.lock.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is generally committed, but can be ignored in some cases.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is generally committed, but can be ignored in some cases.
# pdm.lock

# PEP 582; used by e.g. github.com/pypa/pipflow
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

